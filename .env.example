# RepoPilot configuration — copy to .env and fill in.
# .env is gitignored; never commit real keys.
# REPOPILOT_API_BASE_URL is injected by Docker Compose and does not need to be set here.

# --- LLM provider -------------------------------------------------
# "openai_compatible" (default: DeepSeek) or "anthropic"
REPOPILOT_LLM_PROVIDER=openai_compatible

# DeepSeek via OpenAI-compatible endpoint (default provider, decision D-008)
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-...
REPOPILOT_MODEL=deepseek-v4-pro

# Anthropic (alternative provider; set REPOPILOT_LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# REPOPILOT_MODEL=claude-opus-4-8

# --- Agent budgets ------------------------------------------------
REPOPILOT_MAX_STEPS=20
REPOPILOT_TOOL_TIMEOUT_S=60
REPOPILOT_MAX_REPLANS=3
REPOPILOT_MAX_FIX_CYCLES=2

# --- Storage ------------------------------------------------------
REPOPILOT_DB_PATH=data/repopilot.sqlite3
REPOPILOT_TRACE_DIR=data/traces
REPOPILOT_WORKSPACE_DIR=data/repos
